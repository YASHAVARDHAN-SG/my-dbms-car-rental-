FROM php:8.2-cli

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

RUN apt-get update \
    && apt-get install -y --no-install-recommends libonig-dev libxml2-dev pkg-config \
    && docker-php-ext-install dom mbstring xml xmlwriter \
    && pecl install xdebug-3.4.6 \
    && docker-php-ext-enable xdebug \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/test-tools
COPY composer.json ./
RUN composer install --no-interaction --prefer-dist --no-progress

ENV XDEBUG_MODE=coverage

ENTRYPOINT ["/opt/test-tools/vendor/bin/phpunit"]
